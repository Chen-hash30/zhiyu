{
  "name": "zhiyu",
  "version": "1.1.7",
  "productName": "知屿",
  "private": true,
  "description": "知屿 —— 本地优先的 AI 个人知识库",
  "main": "electron/main.cjs",
  "author": "知屿",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n WEB,APP -c cyan,magenta \"vite --port 5173 --strictPort\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "test": "node --test tests/*.test.cjs",
    "shoot": "node scripts/shoot.mjs",
    "setup:model": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mozilla/readability": "^0.6.0",
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^3.6.0",
    "diff": "^5.2.0",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.0",
    "mammoth": "^1.13.0",
    "turndown": "^7.2.0",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@uiw/react-codemirror": "^4.23.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "d3-force": "^3.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.1.0",
    "playwright-core": "^1.50.0",
    "png-to-ico": "^2.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "sharp": "^0.34.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0",
    "zustand": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chen-hash30/zhiyu.git"
  },
  "homepage": "https://github.com/Chen-hash30/zhiyu#readme",
  "bugs": {
    "url": "https://github.com/Chen-hash30/zhiyu/issues"
  }
}
